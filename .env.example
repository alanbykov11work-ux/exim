# Server-only PostgreSQL connection. Never expose it through NEXT_PUBLIC_*.
DATABASE_URL=postgresql://exim_superapp:CHANGE_ME@postgres:5432/exim_superapp
DATABASE_POOL_SIZE=10

# Private persistent file volume inside the application container.
DOCUMENTS_ROOT=/data/documents

# `disabled` is allowed only for the isolated preview environment.
# Switch to `smtp` before a public launch and configure a mail provider.
EMAIL_VERIFICATION_MODE=disabled

# Public origin of the isolated managed preview.
APP_BASE_URL=https://superapp.185-129-49-242.sslip.io
